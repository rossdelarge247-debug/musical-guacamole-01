# =============================================================================
# INTERVIEW MONKEY — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# Demo mode is automatically active for any service whose key is not set.
# =============================================================================

# --- SUPABASE (database, auth, storage, realtime) ---
# Sign up at: https://supabase.com
# Create a project in EU West (London) region
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ANTHROPIC (AI — story engine, signal engine, answer lab, etc.) ---
# Sign up at: https://console.anthropic.com
# Models used: claude-sonnet-4-6 (most tasks), claude-opus-4-6 (deep reasoning)
ANTHROPIC_API_KEY=

# --- DEEPGRAM (real-time transcription for Human-Led Mock & Live Workspace) ---
# Sign up at: https://deepgram.com (200 hrs/month free tier)
# Demo mode: uses browser Web Speech API when this is not set
DEEPGRAM_API_KEY=

# --- STRIPE (payments) ---
# Sign up at: https://stripe.com
# Test mode keys work immediately — no business verification needed for test
# Demo mode: Stripe test mode is used when STRIPE_SECRET_KEY is not set
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (create in your Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRIME_MONTHLY=
STRIPE_PRICE_PRIME_ANNUAL=
STRIPE_PRICE_COACH_MODE_ADDON=

# --- GOOGLE OAUTH ---
# Sign up at: https://console.cloud.google.com
# Create OAuth 2.0 credentials — redirect URI: {SUPABASE_URL}/auth/v1/callback
# Demo mode: email/password auth only when these are not set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- RESEND (transactional email) ---
# Sign up at: https://resend.com — verify your sending domain
# Demo mode: emails are logged to console when this is not set
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@interviewmonkey.co.uk

# --- MONITORING ---
# Sentry: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development
